# n8n credential encryption key (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=
# Groq API key, primary LLM provider (console.groq.com)
GROQ_API_KEY=
# Google Gemini API key, LLM fallback (aistudio.google.com)
GEMINI_API_KEY=
# Jina Reader API key, optional: faster board fetches (jina.ai)
JINA_API_KEY=
# Code-node task timeout in seconds (n8n default 300 kills the LLM loop)
N8N_RUNNERS_TASK_TIMEOUT=1800
# Discord webhook for the "Job Radar Alerts" error workflow (failures only)
DISCORD_WEBHOOK_URL=
